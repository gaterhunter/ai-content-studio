# SQLite cho chạy thử; production dùng PostgreSQL (+ pgvector ở V1)
DATABASE_URL=sqlite:///./studio.db
# DATABASE_URL=postgresql+psycopg://studio:studio@localhost:5432/studio

# Nhà cung cấp AI: "mock" (offline), "gemini" hoặc "anthropic". Có thể đổi và dán khóa ngay trong giao diện (trang Cài đặt),
# khóa lưu trong DB đã mã hóa và được ưu tiên hơn các biến dưới đây.
LLM_PROVIDER=mock
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_GEMINI_WRITER_MODEL=gemini-2.5-pro
LLM_GEMINI_FAST_MODEL=gemini-2.5-flash
# Mô hình mạnh cho viết nội dung, mô hình rẻ cho phân loại/lọc trend
LLM_WRITER_MODEL=claude-opus-5-5
LLM_FAST_MODEL=claude-haiku-4-5

# Khóa Fernet để mã hóa token mạng xã hội (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=

# Số ngày tối thiểu để quay + duyệt + đăng; trend còn ít hơn thì loại
PRODUCTION_LEAD_DAYS=2
CORS_ORIGINS=http://localhost:3000
